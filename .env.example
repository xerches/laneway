# Copy this file to .env.local and fill it in. Never commit .env.local.

# Postgres connection string. Not needed on Netlify, which provides its own
# database automatically.
DATABASE_URL=postgres://laneway:laneway@127.0.0.1:5432/laneway_dev

# A long random secret that signs login sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address people open the app at. Needed locally; optional on Netlify.
BETTER_AUTH_URL=http://localhost:3000

# Leave this out to keep sign-ups closed after the first account is created.
# Set to "open" to let anyone create an account.
# SIGNUPS=open
