# Copy this file to .env (same folder as docker-compose.yml) and fill it in.
# On Windows, scripts/setup.ps1 does this for you. Never commit .env.

# Signs login sessions. Make one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Password for the bundled Postgres. Pick it before the first start; changing
# it later means changing it inside the database too.
POSTGRES_PASSWORD=

# Every address you open Laneway at, comma-separated. Add your Tailscale
# address once `tailscale serve` is set up, for example:
#   LANEWAY_URLS=http://localhost:3000,https://ad-desktop.your-tailnet.ts.net
LANEWAY_URLS=http://localhost:3000

# Where the nightly backups go, and how many days of them to keep.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Leave empty to keep sign-ups closed once your account exists.
SIGNUPS=
